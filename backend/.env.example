# HTTP server
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas or a local MongoDB connection string
# (replace the placeholder below with your real values in .env — never commit them)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>/finance_app?retryWrites=true&w=majority&appName=Cluster0

# Use a long, random value in your real .env file (never commit it)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
